{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C: Build active file",
            "type": "process",
            "command": "gcc",
            "args": [
                "-std=c17",
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "-Wno-return-type",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "C: Build and run active file",
            "type": "process",
            "command": "${fileDirname}\\${fileBasenameNoExtension}.exe",
            "dependsOn": "C: Build active file",
            "dependsOrder": "sequence",
            "options": {
                "cwd": "${fileDirname}"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "clear": true
            }
        }
    ]
}
